
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nis2-check.local/schemas/agent-result.schema.json",
  "title": "NIS2-Check Agent Result",
  "description": "Format commun des résultats transmis par les agents Linux et Windows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset",
    "agent",
    "collected_at",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "hostname",
        "platform",
        "os_version"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "enum": ["linux", "windows"]
        },
        "os_version": {
          "type": "string"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "status",
          "severity",
          "message",
          "evidence"
        ],
        "properties": {
          "control_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "echec",
              "attention",
              "non_verifie",
              "ignore",
              "non_applicable"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "observed_value": {},
              "source": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
